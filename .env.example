# ==============================================================================
# ResearchGate AI — Root Environment Example
# Copy this to .env (or configure backend/.env and frontend/.env separately)
# ==============================================================================

# --- Backend Configuration ---
# Your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Supported model: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:8501

# --- Frontend Configuration ---
# FastAPI backend API URL
BACKEND_API_URL=http://localhost:8000/api/v1
